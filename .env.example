NUXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NUXT_PUBLIC_SUPABASE_KEY=your_supabase_anon_key
NUXT_SUPABASE_SECRET_KEY=your_supabase_secret_key

# ==============================================================================
# META / INSTAGRAM GRAPH API CREDENTIALS (SMK IT ATTAQWA 9)
# ==============================================================================
# Masukkan App ID dari Meta for Developers (Instagram Basic Display / Graph API)
NUXT_PUBLIC_INSTAGRAM_APP_ID=

# Masukkan App Secret dari dashboard Meta App
INSTAGRAM_APP_SECRET=

# Masukkan Long-Lived User Access Token Instagram (60-day refreshable)
INSTAGRAM_ACCESS_TOKEN=

# ==============================================================================
# OCR BANK SOAL (ekstrak teks/rumus dari gambar) - API kompatibel OpenAI (/chat/completions)
# ==============================================================================
# Dua pembaca independen: utama + pemeriksa. Pemeriksa memakai URL/kunci utama bila OCR_KEDUA_URL/KEY kosong.
# Contoh 1 akun GLM (Z.ai): utama glm-4.6v, pemeriksa glm-4.6v-flash.
# Contoh dua vendor: utama GLM, pemeriksa DeepSeek (https://api.deepseek.com, model deepseek-v4-flash-vision-exp).
# Periksa nama model dan URL terbaru di dashboard masing-masing penyedia sebelum dipakai.
OCR_UTAMA_URL=
OCR_UTAMA_KEY=
OCR_UTAMA_MODEL=
# Isi false bila penyedia menolak response_format (mode JSON); prompt tetap meminta JSON.
# OCR_UTAMA_JSON=false
OCR_KEDUA_URL=
OCR_KEDUA_KEY=
OCR_KEDUA_MODEL=
# OCR_KEDUA_JSON=false
